-.cert-detail-meta dd{margin:0;text-align:right;overflow-wrap:anywhere;min-width:0}
-.cert-record{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 0;border-bottom:1px solid var(--line);min-width:0;font-size:calc(12px * var(--ui-font-scale))}
-.cert-record>div{min-width:0}
