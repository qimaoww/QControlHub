[Unit]
Description=Remove only the recorded QControlHub multiuser-d6b9 validation resources
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /var/lib/qch-validation/multiuser-d6b9/cleanup.py --manifest /var/lib/qch-validation/multiuser-d6b9/manifest.json --execute --result /var/lib/qch-validation/multiuser-d6b9/result.json
Restart=on-failure
RestartSec=300
TimeoutStartSec=180
