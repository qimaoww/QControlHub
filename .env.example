# Copying this file is not enough: empty secrets intentionally make Compose fail.
# Prefer `make init-env`, which creates a mode-0600 .env with URL-safe random values.

POSTGRES_DB=qcontrolhub
POSTGRES_USER=qcontrolhub
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Must contain at least 32 bytes. Agent enrollment tokens are issued from the UI/API.
QCH_ADMIN_TOKEN=

# Optional: additional bearer/login tokens with lower privilege levels.
# Each is a comma-separated list of tokens (>= 32 bytes each).
QCH_OPERATOR_TOKENS=
QCH_READONLY_TOKENS=

# Optional: signs webhook deliveries with HMAC-SHA256 (X-QControlHub-Signature).
# Leave empty to disable webhook signing; delivery still requires a URL in settings.
QCH_WEBHOOK_SECRET=

# Optional: AES-256-GCM at-rest encryption key for configuration payloads.
# Legacy plaintext rows keep working; losing this key makes data undecryptable.
QCH_CONFIG_ENCRYPTION_KEY=

# Optional: external Docker network containing an existing PostgreSQL service.
# Set this together with QCH_DATABASE_URL in external deployment mode.
QCH_DATABASE_NETWORK=

# The Compose control plane listens on its container interface, while TLS terminates
# at the loopback-only Nginx upstream. Never claim this unless that proxy is in place.
QCH_BEHIND_TLS_PROXY=true
QCH_ALLOW_INSECURE_HTTP=false

# This is acceptable only for the bundled PostgreSQL on Compose's internal network.
# Use false with sslmode=verify-full for any external database.
QCH_ALLOW_INSECURE_DATABASE=true

# Exact comma-separated browser origins allowed to call the JSON API.
# Same-origin Web UI usage does not require this setting.
QCH_CORS_ORIGINS=https://qcontrolhub.example.com

# Exact Docker gateway trusted to supply X-Forwarded-For from host Nginx.
# If this subnet conflicts locally, change all three values together.
QCH_CONTROL_PROXY_SUBNET=172.31.254.0/24
QCH_CONTROL_PROXY_GATEWAY=172.31.254.1
QCH_TRUSTED_PROXY_CIDRS=172.31.254.1/32

# Compose publishes the control plane and PostgreSQL on loopback by default.
QCH_BIND_ADDRESS=127.0.0.1
QCH_PORT=8080

# GHCR image tag. Use local only when building from this checkout.
QCH_IMAGE_TAG=latest
VERSION=dev
