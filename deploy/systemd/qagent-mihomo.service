[Unit]
Description=Mihomo core managed by QAgent
Documentation=https://github.com/MetaCubeX/mihomo
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/usr/local/lib/qagent/cores/mihomo
ConditionPathExists=/etc/qagent/mihomo/config.yaml

[Service]
Type=simple
User=qcontrolhub-core
Group=qcontrolhub-core
WorkingDirectory=/var/lib/qcontrolhub-mihomo
StateDirectory=qcontrolhub-mihomo
StateDirectoryMode=0750
UMask=0027
ExecStart=/usr/local/lib/qagent/cores/mihomo -d /var/lib/qcontrolhub-mihomo -f /etc/qagent/mihomo/config.yaml
LogNamespace=qagent-cores
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s

NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadOnlyPaths=/usr/local/lib/qagent/cores/mihomo /etc/qagent/mihomo
ReadWritePaths=/var/lib/qcontrolhub-mihomo

[Install]
WantedBy=multi-user.target
