[Unit]
Description=QControlHub remote engine agent
Documentation=https://github.com/qimaoww/qcontrolhub
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/qcontrolhub/agent.env
WorkingDirectory=/var/lib/qcontrolhub
StateDirectory=qcontrolhub
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/bin/qagent
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

# The agent needs narrowly scoped writes to engine configuration directories and
# to its own private executable so a signed panel upgrade can replace it
# atomically. The installer keeps /usr/local/bin/qagent as a compatibility
# symlink; administrator-managed programs in that directory remain read-only.
ProtectSystem=strict
ReadWritePaths=/var/lib/qcontrolhub
# Version switching creates an atomic candidate and backup beside each core.
# Keep every managed core below an application-private directory so binaries
# installed by the server administrator in /usr/local/bin remain untouched.
ReadWritePaths=-/usr/local/lib/qagent/cores
ReadWritePaths=-/usr/local/lib/qagent
ReadWritePaths=-/etc/qagent
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
# Atomic replacement preserves a protected existing file's group so non-root
# core services keep access after deploy, upgrade, and rollback.
# Managed configuration validation drops the child process to the same
# qcontrolhub-core identity used by the service before invoking the real core.
# CAP_NET_ADMIN is limited to the Agent's dedicated nftables table for
# engine-independent per-port traffic accounting and quota enforcement.
CapabilityBoundingSet=CAP_CHOWN CAP_SETGID CAP_SETUID CAP_NET_ADMIN
AmbientCapabilities=CAP_CHOWN CAP_SETGID CAP_SETUID CAP_NET_ADMIN
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true
# Hide process command details without hiding host-wide /proc metrics.
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
