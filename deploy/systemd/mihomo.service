[Unit]
Description=Mihomo proxy core managed by QControlHub
Documentation=https://github.com/MetaCubeX/mihomo
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/usr/local/bin/mihomo
ConditionPathExists=/etc/mihomo/config.yaml

[Service]
Type=simple
User=qcontrolhub-core
Group=qcontrolhub-core
WorkingDirectory=/var/lib/qcontrolhub-mihomo
StateDirectory=qcontrolhub-mihomo
StateDirectoryMode=0750
UMask=0027
ExecStart=/usr/local/bin/mihomo -d /var/lib/qcontrolhub-mihomo -f /etc/mihomo/config.yaml
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadOnlyPaths=/usr/local/bin/mihomo /etc/mihomo
ReadWritePaths=/var/lib/qcontrolhub-mihomo

[Install]
WantedBy=multi-user.target
