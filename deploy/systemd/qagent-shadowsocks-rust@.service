[Unit]
Description=Shared Shadowsocks Rust core managed by QAgent (%i)
Documentation=https://github.com/shadowsocks/shadowsocks-rust
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/usr/local/lib/qagent/cores/ssserver
ConditionPathExists=/etc/qagent/shadowsocks-rust/shares/%i/config.json
ConditionPathExists=/etc/qagent/shadowsocks-rust/shares/%i/qch-mainland-block.acl

[Service]
Type=simple
User=qcontrolhub-core
Group=qcontrolhub-core
WorkingDirectory=/var/lib/qcontrolhub-shadowsocks-rust-%i
StateDirectory=qcontrolhub-shadowsocks-rust-%i
StateDirectoryMode=0750
StateDirectory=qcontrolhub-shadowsocks-rust-%i
StateDirectoryMode=0750
UMask=0027
ExecStart=/usr/local/lib/qagent/cores/ssserver -c /etc/qagent/shadowsocks-rust/shares/%i/config.json --acl /etc/qagent/shadowsocks-rust/shares/%i/qch-mainland-block.acl
Environment=RUST_LOG=info,shadowsocks_service::server::tcprelay=debug,shadowsocks_service::server::udprelay=debug
LogNamespace=qagent-cores
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s

NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadOnlyPaths=/usr/local/lib/qagent/cores/ssserver /etc/qagent/shadowsocks-rust/shares
ReadWritePaths=/var/lib/qcontrolhub-shadowsocks-rust-%i

[Install]
WantedBy=multi-user.target
