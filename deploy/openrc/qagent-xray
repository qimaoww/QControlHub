#!/sbin/openrc-run
# QControlHub managed OpenRC service: qagent-xray

description="Xray core managed by QAgent"
command="/bin/sh"
command_args="-c 'exec /usr/local/lib/qagent/cores/xray run -config /etc/qagent/xray/config.json >>/var/log/qagent/qagent-xray.log 2>&1'"
command_user="qcontrolhub-core:qcontrolhub-core"
directory="/var/lib/qcontrolhub-xray"
supervisor="supervise-daemon"
respawn_delay=3
respawn_max=5
capabilities="^cap_net_bind_service"
no_new_privs=true
umask=0027
depend() { need net; }

start_pre() {
	# supervise-daemon drops privileges before opening output files, so the
	# log file is pre-created with the service user as its owner and the
	# core itself appends through the exec redirect above.
	checkpath --directory --owner root:qcontrolhub-core --mode 0750 /var/log/qagent
	checkpath --file --owner qcontrolhub-core:qcontrolhub-core --mode 0640 /var/log/qagent/qagent-xray.log
	[ -x "/usr/local/lib/qagent/cores/xray" ] || { eerror "missing Xray binary: /usr/local/lib/qagent/cores/xray"; return 1; }
	[ -f "/etc/qagent/xray/config.json" ] || { eerror "missing Xray configuration"; return 1; }
}
