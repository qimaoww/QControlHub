#!/sbin/openrc-run
# QControlHub managed OpenRC service: qagent-shadowsocks-rust

description="Shadowsocks Rust core managed by QAgent"
command="/bin/sh"
command_args="-c 'exec /usr/local/lib/qagent/cores/ssserver -c /etc/qagent/shadowsocks-rust/config.json --acl /etc/qagent/shadowsocks-rust/qch-mainland-block.acl >>/var/log/qagent/qagent-shadowsocks-rust.log 2>&1'"
command_user="qcontrolhub-core:qcontrolhub-core"
directory="/var/lib/qcontrolhub-shadowsocks-rust"
supervisor="supervise-daemon"
respawn_delay=3
respawn_max=5
capabilities="^cap_net_bind_service,^cap_net_admin"

# QCH core bounding policy begin
# libcap IAB caret entries grant ambient/inheritable caps; they do not bound
# the process. Exclude every other Linux capability, including future ones.
qch_last_cap=$(cat /proc/sys/kernel/cap_last_cap) || exit 1
case "$qch_last_cap" in ''|*[!0-9]*) eerror "invalid kernel capability limit"; exit 1 ;; esac
qch_cap=0
while [ "$qch_cap" -le "$qch_last_cap" ]; do
    case "$qch_cap" in 10|12) ;; *) capabilities="${capabilities},!${qch_cap}" ;; esac
    qch_cap=$((qch_cap + 1))
done
# QCH core bounding policy end
no_new_privs=true
umask=0027
export RUST_LOG="info,shadowsocks_service::server::tcprelay=debug,shadowsocks_service::server::udprelay=debug"
depend() { need net; }

start_pre() {
	# supervise-daemon drops privileges before opening output files, so the
	# log file is pre-created with the service user as its owner and the
	# core itself appends through the exec redirect above.
	checkpath --directory --owner root:qcontrolhub-core --mode 0750 /var/log/qagent
	checkpath --file --owner qcontrolhub-core:qcontrolhub-core --mode 0640 /var/log/qagent/qagent-shadowsocks-rust.log
	[ -x "/usr/local/lib/qagent/cores/ssserver" ] || { eerror "missing Shadowsocks Rust binary: /usr/local/lib/qagent/cores/ssserver"; return 1; }
	[ -f "/etc/qagent/shadowsocks-rust/config.json" ] || { eerror "missing Shadowsocks Rust configuration"; return 1; }
	[ -f "/etc/qagent/shadowsocks-rust/qch-mainland-block.acl" ] || { eerror "missing Shadowsocks Rust mainland ACL"; return 1; }
}
