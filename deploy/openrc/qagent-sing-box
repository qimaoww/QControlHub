#!/sbin/openrc-run
# QControlHub managed OpenRC service: qagent-sing-box

description="sing-box core managed by QAgent"
command="/bin/sh"
command_args="-c 'exec /usr/local/lib/qagent/cores/sing-box run -c /etc/qagent/sing-box/config.json >>/var/log/qagent/qagent-sing-box.log 2>&1'"
command_user="qcontrolhub-core:qcontrolhub-core"
directory="/var/lib/qcontrolhub-sing-box"
supervisor="supervise-daemon"
respawn_delay=3
respawn_max=10000
capabilities="^cap_net_bind_service"
no_new_privs=true
umask=0027
depend() { need net; }

start_pre() {
	# supervise-daemon drops privileges before opening output files, so the
	# log file is pre-created with the service user as its owner and the
	# core itself appends through the exec redirect above.
	checkpath --directory --owner root:qcontrolhub-core --mode 0750 /var/log/qagent
	checkpath --file --owner qcontrolhub-core:qcontrolhub-core --mode 0640 /var/log/qagent/qagent-sing-box.log
	[ -x "/usr/local/lib/qagent/cores/sing-box" ] || { eerror "missing sing-box binary: /usr/local/lib/qagent/cores/sing-box"; return 1; }
	[ -f "/etc/qagent/sing-box/config.json" ] || { eerror "missing sing-box configuration"; return 1; }
}
