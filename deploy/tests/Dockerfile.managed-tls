FROM debian:trixie-slim
# Nginx is intentionally absent; the actual fixed Agent helper installs it.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends systemd dbus ca-certificates \
    && groupadd --system qcontrolhub-core \
    && useradd --system --gid qcontrolhub-core --no-create-home qcontrolhub-core \
    && mkdir -p /etc/qcontrolhub /var/lib/qcontrolhub \
    && touch /etc/qcontrolhub/agent.env
COPY qagent tls.test /usr/local/lib/qagent/
COPY cores/bin/ /usr/local/lib/qagent/cores/
COPY xhttp.crt xhttp.key /etc/qcontrolhub/tls/
COPY xhttp.crt /etc/qcontrolhub/panel-certificates/crt_0000000000000001/cert.pem
COPY xhttp.key /etc/qcontrolhub/panel-certificates/crt_0000000000000001/key.pem
RUN chown -R root:qcontrolhub-core /etc/qcontrolhub/panel-certificates && chmod -R g+rX,o-rwx /etc/qcontrolhub/panel-certificates
RUN chown -R root:qcontrolhub-core /etc/qcontrolhub/tls && chmod 0750 /etc/qcontrolhub/tls && chmod 0640 /etc/qcontrolhub/tls/*
COPY qagent.service /etc/systemd/system/qagent.service
STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
