FROM golang:1.26.10-bookworm
RUN apt-get update && apt-get install --no-install-recommends --yes iproute2 && rm -rf /var/lib/apt/lists/*
RUN groupadd --system qcontrolhub-core && useradd --system --gid qcontrolhub-core --no-create-home qcontrolhub-core
COPY deploy/tests/sandbox-systemd-run.sh /usr/bin/systemd-run
RUN chmod 0555 /usr/bin/systemd-run
WORKDIR /src
